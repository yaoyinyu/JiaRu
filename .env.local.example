# Agnes Image 2.1 Flash 配置
# 1. 复制此文件为 .env.local
# 2. 填入你的 Agnes API Key
# 3. 重启开发服务器 (npm.cmd run dev)

AGNES_API_KEY=your-key-here
AGNES_API_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_IMAGE_MODEL=agnes-image-2.1-flash

# 火山方舟 Seedream 5.0 配置（/ai-generate 页面"生成引擎"可选）
# 1. 在火山方舟控制台开通 Seedream 5.0 pro / lite，并在 API Key 管理页获取长效 Key
# 2. 查询两个模型各自的 Model ID（pro/lite 是不同 ID）
# 3. 填入 .env.local 并重启服务；未配置时选择 Seedream 会返回 503 提示
VOLCENGINE_ARK_API_KEY=your-key-here
# 可选：默认北京区域端点，其他区域时才需要改
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_SEEDREAM_PRO_MODEL=doubao-seedream-5-0-pro-260628
# 文档语境的"Seedream 5.0 lite"对应基础版 5.0 模型（2026-09 实测：账号列表无独立 lite ID）
# 需在方舟控制台开通后方可使用；也可改填已开通的 doubao-seedream-4-5-251128 等
ARK_SEEDREAM_LITE_MODEL=doubao-seedream-5-0-260128
# 可选：是否在生成图片上添加"AI 生成"水印（默认关闭，美甲设计导出场景）
# ARK_IMAGE_WATERMARK=false

# ── AI 生图配额与预算熔断（/api/generate-ai 与 /api/generate-seedream 共用）──
# 全部可选；非法值回退默认。进程内存态，重启清零（单实例部署口径）。
# AI_QUOTA_GUEST_DAILY=5          # 游客单日生成上限（默认 5）
# AI_QUOTA_USER_DAILY=20          # 登录用户单日生成上限（默认 20）
# AI_QUOTA_GLOBAL_DAILY=200       # 全局单日生成上限，预算熔断（默认 200）
# AI_QUOTA_GLOBAL_CONCURRENCY=3   # 全局同时生成任务上限（默认 3）

# 可选：仅在受控测试中覆盖浏览器端美甲纹理模型 manifest。
# 默认保持注释，浏览器将使用 /models/nail-texture-seg/manifest.json。
# Smoke 模型只能临时用于工程链路验证，不得写成共享环境的默认值。
# NEXT_PUBLIC_NAIL_TEXTURE_MODEL_MANIFEST_URL=/models/nail-texture-seg-smoke/manifest.json

# ── 用户系统（Phase 1 初始注册登录）──
# JWT 签名密钥：生产环境必须配置至少 16 位随机字符串；
# 未配置时本地开发使用内置回退密钥（重启不失效），生产构建会直接报错。
# JWT_SECRET=请填写至少16位的随机字符串

# 用户数据库文件路径（默认 <项目根>/data/jiaru-user.db）
# JIARU_DB_PATH=./data/jiaru-user.db

# ── 安全相关（2026-09-24 安全审计新增，全部可选）──

# 是否信任反向代理注入的来源头（部署在 Nginx 之后必须设为 1）。
# 设为 1 后应用采信 X-Real-IP / X-Forwarded-For 最右侧一跳作为客户端 IP，
# 用于 IP 限流与审计日志；未设置时一律按 "unknown" 处理（保守、防伪造）。
# JIARU_TRUST_PROXY=1

# CSRF 允许的额外来源（逗号分隔）。服务端默认允许当前访问域名；
# 局域网或隧道联调时需要把访问地址写进来，否则写操作会被 403 拒绝。
# JIARU_ALLOWED_ORIGINS=http://192.168.1.100:3000,https://xxx.trycloudflare.com

# 强制开启短信"开发模式"（明文验证码经接口返回）。默认规则：
# 生产环境一律禁止；非生产环境仅允许本机/私网直连访问。
# 仅在确实需要且确认不外泄时设为 1。
# JIARU_DEV_SMS=1

# IP 限流阈值覆盖（每 IP 每窗口），非法值回退默认：
#   captcha 30/5min、requestCode 5/10min、verifyCode 20/10min、
#   bindPhone 10/10min、oauthStart 20/10min
# JIARU_RL_CAPTCHA=30
# JIARU_RL_REQUEST_CODE=5
# JIARU_RL_VERIFY_CODE=20
# JIARU_RL_BIND_PHONE=10
# JIARU_RL_OAUTH_START=20

# 短信服务商：留空时进入"开发模式"，验证码直接通过接口返回（仅限本地联调，
# 生产环境留空会拒绝发送）。配置后需接入阿里云/腾讯云短信（文档 §10.1）。
# SMS_PROVIDER=aliyun

# 微信扫码登录（文档 §5.1）：微信开放平台「网站应用」OAuth 2.0，
# 需认证企业主体（300 元/年）。未配置时登录页按钮显示「未配置」。
# WECHAT_APP_ID=wx-your-app-id
# WECHAT_APP_SECRET=your-app-secret
