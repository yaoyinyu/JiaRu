# Agnes Image 2.1 Flash 配置
# 1. 复制此文件为 .env.local
# 2. 填入你的 Agnes API Key
# 3. 重启开发服务器 (npm.cmd run dev)

AGNES_API_KEY=your-key-here
AGNES_API_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_IMAGE_MODEL=agnes-image-2.1-flash

# 可选：仅在受控测试中覆盖浏览器端美甲纹理模型 manifest。
# 默认保持注释，浏览器将使用 /models/nail-texture-seg/manifest.json。
# Smoke 模型只能临时用于工程链路验证，不得写成共享环境的默认值。
# NEXT_PUBLIC_NAIL_TEXTURE_MODEL_MANIFEST_URL=/models/nail-texture-seg-smoke/manifest.json

# ── 用户系统（Phase 1 初始注册登录）──
# JWT 签名密钥：生产环境必须配置至少 16 位随机字符串；
# 未配置时本地开发使用内置回退密钥（重启不失效），生产构建会直接报错。
# JWT_SECRET=请填写至少16位的随机字符串

# 用户数据库文件路径（默认 <项目根>/data/jiaru-user.db）
# JIARU_DB_PATH=./data/jiaru-user.db

# 短信服务商：留空时进入"开发模式"，验证码直接通过接口返回（仅限本地联调，
# 生产环境留空会拒绝发送）。配置后需接入阿里云/腾讯云短信（文档 §10.1）。
# SMS_PROVIDER=aliyun

# 微信扫码登录（文档 §5.1）：微信开放平台「网站应用」OAuth 2.0，
# 需认证企业主体（300 元/年）。未配置时登录页按钮显示「未配置」。
# WECHAT_APP_ID=wx-your-app-id
# WECHAT_APP_SECRET=your-app-secret
